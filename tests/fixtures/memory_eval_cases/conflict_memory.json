{
  "id": "conflict_memory",
  "title": "Opposite preference memories should be measurable as conflict",
  "category": "conflict_detection",
  "phase_targets": ["phase4a", "phase5"],
  "config_profiles": ["off", "phase4", "phase5", "all"],
  "setup": {
    "scope": {"session_key": "cli:local", "channel": "cli", "chat_id": "local"},
    "memory_items": [
      {
        "id": "m_like_cn",
        "memory_type": "preference",
        "summary": "用户喜欢使用中文回答",
        "status": "active",
        "source_ref": "cli:local@post_response",
        "scope_channel": "cli",
        "scope_chat_id": "local"
      },
      {
        "id": "m_dislike_cn",
        "memory_type": "preference",
        "summary": "用户不喜欢使用中文回答",
        "status": "active",
        "source_ref": "cli:local@post_response",
        "scope_channel": "cli",
        "scope_chat_id": "local"
      }
    ],
    "memory_replacements": [
      {
        "old_item_id": "m_old_language_pref",
        "new_item_id": "m_like_cn",
        "relation_type": "supersedes",
        "source_ref": "cli:local@post_response"
      },
      {
        "old_item_id": "m_old_language_pref",
        "new_item_id": "m_dislike_cn",
        "relation_type": "supersedes",
        "source_ref": "cli:local@post_response"
      }
    ],
    "query": "我喜欢中文回答吗？"
  },
  "expectations": {
    "should_recall_ids": [],
    "should_not_recall_ids": [],
    "expected_trace_features": [
      "version_chain_shadow",
      "sleep_consolidation_shadow"
    ],
    "expected_metric_keys": {
      "version_chain_shadow": ["conflict_chain_count"],
      "sleep_consolidation_shadow": ["conflict_candidate_count"]
    },
    "profile_expectations": {
      "off": {
        "forbidden_trace_features": [
          "version_chain_shadow",
          "sleep_consolidation_shadow"
        ]
      },
      "phase4": {
        "required_trace_features": ["version_chain_shadow"],
        "metric_keys": {"version_chain_shadow": ["conflict_chain_count"]}
      },
      "phase5": {
        "required_trace_features": ["sleep_consolidation_shadow"],
        "metric_keys": {
          "sleep_consolidation_shadow": ["conflict_candidate_count"]
        }
      },
      "all": {
        "required_trace_features": [
          "version_chain_shadow",
          "sleep_consolidation_shadow"
        ]
      }
    }
  }
}
