{
  "id": "duplicate_memory",
  "title": "Duplicate long-term memories should be measurable",
  "category": "duplicate_detection",
  "phase_targets": ["phase1", "phase5"],
  "config_profiles": ["off", "phase1", "phase5", "all"],
  "setup": {
    "scope": {"session_key": "cli:local", "channel": "cli", "chat_id": "local"},
    "memory_items": [
      {
        "id": "m_dup_1",
        "memory_type": "preference",
        "summary": "用户喜欢中文回答",
        "status": "active",
        "source_ref": "cli:local@post_response",
        "scope_channel": "cli",
        "scope_chat_id": "local"
      },
      {
        "id": "m_dup_2",
        "memory_type": "preference",
        "summary": "用户喜欢中文回答",
        "status": "active",
        "source_ref": "cli:local@post_response",
        "scope_channel": "cli",
        "scope_chat_id": "local"
      }
    ],
    "query": "你记得我的回答语言偏好吗？"
  },
  "expectations": {
    "should_recall_ids": ["m_dup_1"],
    "should_not_recall_ids": [],
    "expected_trace_features": [
      "write_value_score",
      "sleep_consolidation_shadow"
    ],
    "expected_metric_keys": {
      "write_value_score": ["duplicate_risk_count"],
      "sleep_consolidation_shadow": [
        "duplicate_group_count",
        "estimated_token_saving"
      ]
    },
    "profile_expectations": {
      "off": {
        "forbidden_trace_features": [
          "write_value_score",
          "sleep_consolidation_shadow"
        ]
      },
      "phase1": {
        "required_trace_features": ["write_value_score"],
        "metric_keys": {"write_value_score": ["duplicate_risk_count"]}
      },
      "phase5": {
        "required_trace_features": ["sleep_consolidation_shadow"],
        "metric_keys": {
          "sleep_consolidation_shadow": [
            "duplicate_group_count",
            "estimated_token_saving"
          ]
        }
      },
      "all": {
        "required_trace_features": [
          "write_value_score",
          "sleep_consolidation_shadow"
        ]
      }
    }
  }
}
